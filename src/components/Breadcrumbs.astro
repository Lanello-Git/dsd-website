---
import Icon from './Icon.astro';
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
const all = [{ name: 'Home', href: '/' }, ...items];
---
<nav class="crumbs" aria-label="Kruimelpad">
  <div class="container">
    <ol>
      {all.map((c, i) => (
        <li>
          {i < all.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
          {i < all.length - 1 && <Icon name="chevron-right" size={14} />}
        </li>
      ))}
    </ol>
  </div>
</nav>

<style>
  .crumbs { background: var(--c-cream); border-bottom: 1px solid var(--c-line); font-size: var(--fs-sm); }
  .crumbs ol { list-style: none; margin: 0; padding: 0.7rem 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .crumbs li { display: inline-flex; align-items: center; gap: 0.35rem; margin: 0; color: var(--c-muted); }
  .crumbs a { color: var(--c-ink); text-decoration: none; }
  .crumbs a:hover { color: var(--c-gold-deep); text-decoration: underline; }
</style>
