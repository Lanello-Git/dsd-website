---
import Icon from './Icon.astro';
import { site } from '../config/site';
import { services } from '../data/services';

interface Props {
  heading?: string;
  intro?: string;
  compact?: boolean;
  /** Pre-select a service in the dropdown. */
  preselect?: string;
  /** Use 3 when the form sits inside a section that already has its own h2. */
  headingLevel?: 2 | 3;
}
const {
  heading = 'Vraag uw gratis offerte aan',
  intro = 'Vul het formulier in en wij bellen u zo snel mogelijk terug voor een gratis en vrijblijvend plaatsbezoek.',
  compact = false,
  preselect,
  headingLevel = 2,
} = Astro.props;
const endpoint = site.formEndpoint;
const embed = site.ghlFormEmbedUrl;
const Heading = headingLevel === 3 ? 'h3' : 'h2';
---
<div class:list={['lead', { 'lead--compact': compact }]} id="offerte">
  <div class="lead__head">
    <Heading class="lead__title">{heading}</Heading>
    <p class="lead__intro">{intro}</p>
  </div>

  {embed ? (
    <iframe src={embed} title="Offerteformulier DSD Dakwerken" class="lead__embed" loading="lazy"></iframe>
  ) : (
    <form class="lead__form" method="post" action={endpoint || undefined} data-endpoint={endpoint} novalidate>
      <div class="field-grid">
        <div class="field">
          <label for="naam">Naam <span aria-hidden="true">*</span></label>
          <input id="naam" name="naam" type="text" autocomplete="name" required aria-describedby="err-naam" data-error="Vul uw naam in." />
          <p class="field__error" id="err-naam" role="alert"></p>
        </div>
        <div class="field">
          <label for="telefoon">Telefoon <span aria-hidden="true">*</span></label>
          <input id="telefoon" name="telefoon" type="tel" autocomplete="tel" inputmode="tel" required aria-describedby="err-telefoon" data-error="Vul uw telefoonnummer in, zodat wij u kunnen bellen." />
          <p class="field__error" id="err-telefoon" role="alert"></p>
        </div>
        <div class="field">
          <label for="email">E-mail</label>
          <input id="email" name="email" type="email" autocomplete="email" aria-describedby="err-email" data-error="Dit e-mailadres lijkt niet juist." />
          <p class="field__error" id="err-email" role="alert"></p>
        </div>
        <div class="field">
          <label for="gemeente">Gemeente <span aria-hidden="true">*</span></label>
          <input id="gemeente" name="gemeente" type="text" autocomplete="address-level2" required aria-describedby="err-gemeente" data-error="Vul uw gemeente in." />
          <p class="field__error" id="err-gemeente" role="alert"></p>
        </div>
        <div class="field field--full">
          <label for="dienst">Waarmee kunnen wij u helpen?</label>
          <select id="dienst" name="dienst">
            <option value="">Maak een keuze</option>
            {services.map((s) => <option value={s.name} selected={preselect === s.slug}>{s.name}</option>)}
            <option value="Andere">Andere</option>
          </select>
        </div>
        <div class="field field--full">
          <label for="bericht">Uw vraag of omschrijving van de werken</label>
          <textarea id="bericht" name="bericht" rows={compact ? 3 : 5}></textarea>
        </div>
        <div class="field field--full field--check">
          <input id="akkoord" name="akkoord" type="checkbox" required aria-describedby="err-akkoord" data-error="Vink aan dat wij u mogen contacteren." />
          <label for="akkoord">Ik ga ermee akkoord dat DSD Dakwerken mijn gegevens gebruikt om mij te contacteren over mijn aanvraag. <a href="/privacybeleid/">Privacybeleid</a> <span aria-hidden="true">*</span></label>
          <p class="field__error field__error--full" id="err-akkoord" role="alert"></p>
        </div>
        <div class="hp" aria-hidden="true">
          <label for="firma_ref">Laat dit veld leeg</label>
          <input id="firma_ref" name="firma_ref" type="text" tabindex="-1" autocomplete="off" />
        </div>
      </div>
      <input type="hidden" name="bron" value="dsddakwerken.be" />
      <input type="hidden" name="pagina" value="" />
      <input type="hidden" name="geladen" value="" />
      <button class="btn btn--gold btn--lg lead__submit" type="submit">Verstuur mijn aanvraag <Icon name="arrow-right" /></button>
      <p class="lead__status" role="alert"></p>
      <noscript><p class="lead__status is-error">Dit formulier heeft JavaScript nodig. Bel ons op <a href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a> of mail naar <a href={`mailto:${site.email}`}>{site.email}</a>.</p></noscript>
      <p class="lead__alt">Liever bellen? <a href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a> of mail naar <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </form>
  )}
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('form.lead__form').forEach((form) => {
    const status = form.querySelector('.lead__status') as HTMLParagraphElement;
    const phoneHref = form.querySelector('.lead__alt a')?.getAttribute('href') ?? '';
    const phoneText = phoneHref.replace('tel:', '');
    const loadedAt = Date.now();
    (form.elements.namedItem('geladen') as HTMLInputElement).value = String(loadedAt);
    (form.elements.namedItem('pagina') as HTMLInputElement).value = location.pathname;

    const fields = Array.from(form.querySelectorAll<HTMLInputElement>('input[data-error]'));
    const showError = (el: HTMLInputElement, msg: string) => {
      el.setAttribute('aria-invalid', 'true');
      const box = form.querySelector<HTMLElement>(`#err-${el.id}`);
      if (box) box.textContent = msg;
    };
    const clearError = (el: HTMLInputElement) => {
      el.removeAttribute('aria-invalid');
      const box = form.querySelector<HTMLElement>(`#err-${el.id}`);
      if (box) box.textContent = '';
    };
    fields.forEach((el) => el.addEventListener('input', () => clearError(el)));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      status.className = 'lead__status';

      // Honeypot or a submit faster than a human can type: pretend success, send nothing.
      const hp = (form.elements.namedItem('firma_ref') as HTMLInputElement).value;
      if (hp || Date.now() - loadedAt < 3000) { window.location.href = '/bedankt/'; return; }

      let firstInvalid: HTMLInputElement | null = null;
      fields.forEach((el) => {
        if (!el.checkValidity()) { showError(el, el.dataset.error ?? 'Controleer dit veld.'); firstInvalid ??= el; } else clearError(el);
      });
      if (firstInvalid) {
        (firstInvalid as HTMLInputElement).focus();
        status.textContent = 'Controleer de aangeduide velden.';
        status.classList.add('is-error');
        return;
      }

      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        status.innerHTML = `Het formulier is nog niet gekoppeld. Bel ons even op <a href="${phoneHref}">${phoneText}</a>, dan helpen wij u meteen verder.`;
        status.classList.add('is-error');
        return;
      }

      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled = true;
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), 10000);
      try {
        const data = Object.fromEntries(new FormData(form).entries());
        const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(data), signal: controller.signal });
        if (!res.ok) throw new Error(String(res.status));
        window.location.href = '/bedankt/';
      } catch {
        status.innerHTML = `Er liep iets mis bij het versturen. Bel ons op <a href="${phoneHref}">${phoneText}</a> of probeer het later opnieuw.`;
        status.classList.add('is-error');
        btn.disabled = false;
      } finally {
        window.clearTimeout(timer);
      }
    });
  });
</script>

<style>
  .lead { background: var(--c-white); border: 1px solid var(--c-line); border-radius: var(--radius-lg); padding: var(--space-6); box-shadow: var(--shadow-lg); }
  .lead--compact { padding: var(--space-5); }
  .lead__title { font-size: var(--fs-xl); margin-bottom: var(--space-2); font-family: var(--font-display); font-weight: 400; }
  .lead__intro { color: var(--c-muted); margin-bottom: var(--space-5); }
  .lead__embed { width: 100%; min-height: 640px; border: 0; }
  .field-grid { display: grid; gap: var(--space-4); grid-template-columns: 1fr; }
  @media (min-width: 560px) { .field-grid { grid-template-columns: 1fr 1fr; } }
  .field { display: grid; gap: 0.35rem; align-content: start; }
  .field--full { grid-column: 1 / -1; }
  .field label { font-weight: 600; font-size: var(--fs-sm); color: var(--c-ink); }
  .field label span { color: var(--c-red); }
  .field input, .field select, .field textarea {
    font: inherit; padding: 0.75rem 0.9rem; border: 1px solid #8f877a; border-radius: var(--radius-sm); background: var(--c-white); color: var(--c-text); min-height: 48px; width: 100%;
  }
  .field input:focus-visible, .field select:focus-visible, .field textarea:focus-visible { border-color: var(--c-gold-deep); outline: 3px solid var(--c-gold-deep); outline-offset: 2px; }
  .field [aria-invalid="true"] { border-color: var(--c-error); }
  .field__error { margin: 0; font-size: var(--fs-xs); color: var(--c-error); min-height: 0; }
  .field__error:empty { display: none; }
  .field--check { grid-template-columns: auto 1fr; align-items: start; gap: 0.6rem; }
  .field--check input { width: 1.25rem; height: 1.25rem; min-height: 0; margin-top: 0.2rem; accent-color: var(--c-gold-deep); }
  .field--check label { font-weight: 400; }
  .field__error--full { grid-column: 1 / -1; }
  .hp { position: absolute; left: -9999px; }
  .lead__submit { width: 100%; margin-top: var(--space-5); }
  .lead__status { margin: var(--space-3) 0 0; font-size: var(--fs-sm); }
  .lead__status:empty { display: none; }
  .lead__status.is-error { color: var(--c-error); }
  .lead__alt { margin-top: var(--space-4); font-size: var(--fs-sm); color: var(--c-muted); }
</style>
