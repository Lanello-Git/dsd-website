---
import Icon from './Icon.astro';
import type { FaqItem } from '../data/types';
interface Props { items: FaqItem[]; heading?: string; intro?: string; id?: string }
const { items, heading = 'Veelgestelde vragen', intro, id = 'faq' } = Astro.props;
---
<section class="section faq" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">FAQ</span>
      <h2 id={`${id}-title`}>{heading}</h2>
      {intro && <p class="lead">{intro}</p>}
    </div>
    <div class="faq__list">
      {items.map((item, i) => (
        <details class="faq__item" open={i === 0}>
          <summary class="faq__q"><span>{item.q}</span><Icon name="chevron-down" class="faq__icon" /></summary>
          <div class="faq__a"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__list { max-width: 50rem; margin-inline: auto; display: grid; gap: var(--space-3); }
  .faq__item { border: 1px solid var(--c-line); border-radius: var(--radius); background: var(--c-white); }
  .faq__item[open] { border-color: var(--c-gold); }
  .faq__q { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); cursor: pointer; list-style: none; padding: 1rem 1.25rem; font-family: var(--font-body); font-weight: 700; font-size: var(--fs-md); color: var(--c-ink); }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q :global(.faq__icon) { flex: none; color: var(--c-gold-deep); transition: transform .2s ease; }
  .faq__item[open] .faq__q :global(.faq__icon) { transform: rotate(180deg); }
  .faq__a { padding: 0 1.25rem 1.25rem; color: var(--c-text); }
</style>
