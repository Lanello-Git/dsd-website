---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/logo-dsd-dakwerken.png';
import { site } from '../config/site';
import { services, serviceHref } from '../data/services';

const current = Astro.url.pathname;
const isActive = (href: string, children?: { href: string }[]) => (href === '/' ? current === '/' : current.startsWith(href) || Boolean(children?.some((c) => current.startsWith(c.href))));
const nav = [
  { label: 'Diensten', href: '/diensten/', children: services.map((s) => ({ label: s.navLabel, href: serviceHref(s.slug) })) },
  { label: 'Realisaties', href: '/realisaties/' },
  { label: 'Werkgebied', href: '/werkgebied/' },
  { label: 'Over ons', href: '/over-ons/' },
  { label: 'Contact', href: '/contact/' },
];
---
<header class="site-header">
  <div class="topbar">
    <div class="container topbar__inner">
      <span><Icon name="map-pin" size={16} /> {site.address.street}, {site.address.postalCode} {site.address.city}</span>
      <span><Icon name="clock" size={16} /> {site.hours[0].days}: {site.hours[0].open} - {site.hours[0].close}</span>
      <a href={`mailto:${site.email}`}><Icon name="mail" size={16} /> {site.email}</a>
    </div>
  </div>
  <div class="container header__inner">
    <a href="/" class="brand" aria-label={`${site.name}, naar de startpagina`}>
      <Image src={logo} alt={`Logo ${site.name}`} width={230} height={85} loading="eager" densities={[1, 2]} />
    </a>

    <nav class="nav" id="site-nav" aria-label="Hoofdmenu">
      <ul class="nav__list">
        {nav.map((item) => (
          <li class:list={['nav__item', { 'nav__item--has-children': item.children }]}>
            <a href={item.href} class:list={['nav__link', { 'is-active': isActive(item.href, item.children) }]} aria-current={current === item.href ? 'page' : undefined}>
              {item.label}
              {item.children && <Icon name="chevron-down" size={16} class="nav__caret" />}
            </a>
            {item.children && (
              <button class="nav__toggle" type="button" aria-expanded="false" aria-controls={`sub-${item.label}`} aria-label={`Open submenu ${item.label}`}>
                <Icon name="chevron-down" size={18} />
              </button>
            )}
            {item.children && (
              <ul class="nav__sub" id={`sub-${item.label}`}>
                {item.children.map((c) => (
                  <li><a href={c.href} class:list={{ 'is-active': isActive(c.href) }}>{c.label}</a></li>
                ))}
                <li class="nav__sub-all"><a href={item.href}>Alle diensten <Icon name="arrow-right" size={14} /></a></li>
              </ul>
            )}
          </li>
        ))}
      </ul>
      <div class="nav__cta">
        <a class="btn btn--gold" href={`tel:${site.phoneE164}`}><Icon name="phone" /> {site.phoneDisplay}</a>
        <a class="btn btn--outline" href="/contact/">Gratis offerte</a>
      </div>
    </nav>

    <div class="header__actions">
      <a class="btn btn--gold header__call" href={`tel:${site.phoneE164}`} aria-label={`Bel ${site.phoneDisplay}`}><Icon name="phone" /><span>{site.phoneDisplay}</span></a>
      <a class="btn btn--outline header__quote" href="/contact/">Gratis offerte</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" id="menu-btn">
        <Icon name="menu" class="menu-btn__open" />
        <Icon name="x" class="menu-btn__close" />
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
    document.body.classList.toggle('nav-open', !open);
    if (!open) window.setTimeout(() => nav?.querySelector<HTMLAnchorElement>('a')?.focus(), 220);
    else btn.focus();
  });
  document.querySelectorAll<HTMLButtonElement>('.nav__toggle').forEach((t) => {
    t.addEventListener('click', () => {
      const open = t.getAttribute('aria-expanded') === 'true';
      t.setAttribute('aria-expanded', String(!open));
      t.setAttribute('aria-label', `${open ? 'Open' : 'Sluit'} submenu`);
      t.closest('.nav__item')?.classList.toggle('is-open', !open);
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('is-open')) btn?.click();
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--c-white); border-bottom: 1px solid var(--c-line); }
  .topbar { background: var(--c-ink); color: #d9d3c6; font-size: var(--fs-xs); }
  .topbar__inner { display: flex; flex-wrap: wrap; gap: 0.4rem var(--space-6); justify-content: center; padding-block: 0.5rem; }
  .topbar span, .topbar a { display: inline-flex; align-items: center; gap: 0.4rem; color: inherit; text-decoration: none; }
  .topbar a:hover { color: var(--c-gold); }
  @media (max-width: 1099px) { .topbar { display: none; } }

  .header__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: var(--header-h); padding-block: 0.75rem; }
  .brand { display: block; line-height: 0; }
  .brand img { width: auto; height: 46px; }
  @media (min-width: 1100px) { .brand img { height: 56px; } }

  .nav__list { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.25rem; align-items: center; }
  .nav__item { position: relative; margin: 0; }
  .nav__link { display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.7rem 0.85rem; color: var(--c-ink); text-decoration: none; font-weight: 600; border-radius: var(--radius-sm); }
  .nav__link:hover, .nav__link.is-active { color: var(--c-gold-deep); background: var(--c-cream); }
  .nav__toggle { display: none; }
  .nav__sub { list-style: none; margin: 0; padding: 0.5rem; position: absolute; top: 100%; left: 0; min-width: 16rem; background: var(--c-white); border: 1px solid var(--c-line); border-radius: var(--radius); box-shadow: var(--shadow-lg); opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity .15s ease, transform .15s ease, visibility .15s; }
  .nav__item--has-children:hover .nav__sub, .nav__item--has-children:focus-within .nav__sub { opacity: 1; visibility: visible; transform: translateY(0); }
  .nav__sub li { margin: 0; }
  .nav__sub a { display: block; padding: 0.55rem 0.8rem; color: var(--c-ink); text-decoration: none; border-radius: var(--radius-sm); font-weight: 500; }
  .nav__sub a:hover, .nav__sub a.is-active { background: var(--c-cream); color: var(--c-gold-deep); }
  .nav__sub-all a { display: inline-flex; align-items: center; gap: 0.3rem; font-weight: 700; color: var(--c-gold-deep); border-top: 1px solid var(--c-line); border-radius: 0; margin-top: 0.3rem; padding-top: 0.7rem; }
  .nav__cta { display: none; }

  .header__actions { display: flex; align-items: center; gap: var(--space-3); }
  .header__call { padding-inline: 1.1rem; }
  .menu-btn { display: none; background: none; border: 2px solid var(--c-ink); border-radius: var(--radius-sm); width: 48px; height: 48px; place-items: center; cursor: pointer; color: var(--c-ink); }
  .menu-btn__close { display: none; }
  .menu-btn[aria-expanded="true"] .menu-btn__open { display: none; }
  .menu-btn[aria-expanded="true"] .menu-btn__close { display: block; }

  @media (max-width: 1099px) {
    .header__quote { display: none; }
    .header__call span { display: none; }
    .header__call { padding: 0; width: 48px; height: 48px; }
    .menu-btn { display: grid; }
    .nav { position: fixed; inset: var(--header-h) 0 0 0; background: var(--c-white); overflow-y: auto; padding: var(--space-4) var(--space-4) var(--space-8); transform: translateX(100%); visibility: hidden; transition: transform .2s ease, visibility 0s linear .2s; }
    .nav.is-open { transform: none; visibility: visible; transition-delay: 0s; }
    .nav__list { flex-direction: column; align-items: stretch; gap: 0; }
    .nav__item { display: grid; grid-template-columns: 1fr auto; border-bottom: 1px solid var(--c-line); }
    .nav__link { padding: 1rem 0.5rem; font-size: var(--fs-lg); }
    .nav__caret { display: none; }
    .nav__toggle { display: grid; place-items: center; width: 52px; background: none; border: 0; color: var(--c-ink); cursor: pointer; }
    .nav__toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
    .nav__sub { position: static; grid-column: 1 / -1; display: none; opacity: 1; visibility: visible; transform: none; box-shadow: none; border: 0; padding: 0 0 0.75rem 0.5rem; }
    .nav__item.is-open .nav__sub { display: block; }
    .nav__cta { display: grid; gap: var(--space-3); margin-top: var(--space-5); }
    :global(body.nav-open) { overflow: hidden; }
  }
</style>
