---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../config/site';
import { photo } from '../data/photos';

interface Props {
  h1: string;
  intro: string;
  image: string;
  imageAlt: string;
  eyebrow?: string;
  /** 'home' = tall hero with USP chips, 'page' = compact */
  variant?: 'home' | 'page';
  primaryLabel?: string;
  primaryHref?: string;
}
const { h1, intro, image, imageAlt, eyebrow, variant = 'page', primaryLabel = 'Vraag een gratis offerte', primaryHref = '/contact/' } = Astro.props;
---
<section class:list={['hero', `hero--${variant}`]}>
  <div class="hero__media">
    <Image src={photo(image)} alt={imageAlt} widths={[640, 960, 1400, 1800]} sizes="(min-width: 1800px) 1800px, 100vw" loading="eager" fetchpriority="high" format="webp" quality={64} />
  </div>
  <div class="container hero__inner">
    <div class="hero__content">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{h1}</h1>
      <p class="hero__intro">{intro}</p>
      <div class="btn-row">
        <a class="btn btn--gold btn--lg" href={primaryHref}>{primaryLabel} <Icon name="arrow-right" /></a>
        <a class="btn btn--outline-light btn--lg" href={`tel:${site.phoneE164}`}><Icon name="phone" /> {site.phoneDisplay}</a>
      </div>
      {variant === 'home' && (
        <ul class="hero__usps">
          {site.usps.map((u) => <li><Icon name="check-circle" size={20} /> {u}</li>)}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  .hero { position: relative; color: var(--c-white); background: var(--c-ink); overflow: hidden; isolation: isolate; }
  .hero__media, .hero__media :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(100deg, rgba(14,14,14,.9) 0%, rgba(14,14,14,.72) 45%, rgba(14,14,14,.35) 100%); }
  @media (max-width: 859px) { .hero::after { background: linear-gradient(180deg, rgba(14,14,14,.84) 0%, rgba(14,14,14,.72) 100%); } }
  .hero__inner { padding-block: var(--space-8); }
  .hero--home .hero__inner { padding-block: clamp(4rem, 8vw, 7.5rem); min-height: min(78vh, 720px); display: flex; align-items: center; }
  .hero__content { max-width: 40rem; }
  .hero h1 { color: var(--c-white); font-size: var(--fs-hero); margin-bottom: var(--space-4); }
  .hero--page h1 { font-size: var(--fs-3xl); }
  .hero .eyebrow { color: var(--c-gold); }
  .hero__intro { font-size: var(--fs-lg); color: #e6e0d4; margin-bottom: var(--space-5); max-width: 36rem; }
  .hero__usps { list-style: none; padding: 0; margin: var(--space-6) 0 0; display: grid; gap: 0.5rem 1.5rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); font-weight: 600; }
  .hero__usps li { display: flex; align-items: center; gap: 0.5rem; margin: 0; }
  .hero__usps svg { color: var(--c-gold); flex: none; }
</style>
