---
import '@fontsource/dm-serif-display/latin.css';
import '@fontsource-variable/source-sans-3/latin.css';
import '../styles/global.css';
import dmSerifWoff2 from '@fontsource/dm-serif-display/files/dm-serif-display-latin-400-normal.woff2?url';
import sourceSansWoff2 from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { servedTowns } from '../data/cities';

interface Props {
  title: string;
  description: string;
  /** Path starting with / and ending with /, e.g. /dakrenovatie/ */
  path: string;
  ogImage?: string;
  noindex?: boolean;
  /** Extra JSON-LD objects for this page (Service, BreadcrumbList, FAQPage). */
  schema?: Record<string, unknown>[];
}

const { title, description, path, ogImage = '/og-default.jpg', noindex = false, schema = [] } = Astro.props;
const canonical = new URL(path, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'RoofingContractor',
  '@id': `${site.url}/#business`,
  name: site.name,
  legalName: site.legalName,
  url: `${site.url}/`,
  foundingDate: String(site.foundedYear),
  hasMap: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${site.address.street}, ${site.address.postalCode} ${site.address.city}`)}`,
  telephone: site.phoneE164,
  email: site.email,
  vatID: site.vat.replace(/[\s.]/g, ''),
  founder: { '@type': 'Person', name: site.owner },
  image: ogImageUrl,
  logo: new URL('/logo-dsd-dakwerken.png', site.url).href,
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  openingHoursSpecification: site.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.schemaDays,
    opens: h.open,
    closes: h.close,
  })),
  areaServed: servedTowns.map((t) => ({ '@type': 'City', name: t.name })),
  sameAs: [site.social.facebook, site.social.instagram].filter(Boolean),
};

const jsonLd = [localBusiness, ...schema];
---
<!doctype html>
<html lang="nl-BE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="theme-color" content="#141414" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={dmSerifWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sourceSansWoff2} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Logo ${site.name}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="geo.region" content="BE-VOV" />
    <meta name="geo.placename" content={site.address.city} />
    {jsonLd.map((obj) => <script is:inline type="application/ld+json" set:html={JSON.stringify(obj).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Ga naar de inhoud</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
