---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactForm from '../components/ContactForm.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const crumbs = [{ name: 'Contact en offerte', href: '/contact/' }];
const mapQuery = encodeURIComponent(`${site.address.street}, ${site.address.postalCode} ${site.address.city}`);
const faq = [
  { q: 'Wat gebeurt er na mijn aanvraag?', a: 'Wij bellen u binnen één werkdag terug om een afspraak te maken voor een gratis plaatsbezoek. Peter komt langs, bekijkt uw dak of woning en bespreekt de mogelijkheden. Daarna krijgt u een offerte met vaste prijzen, meestal binnen de week.' },
  { q: 'Is het plaatsbezoek echt gratis en vrijblijvend?', a: 'Ja. Het plaatsbezoek en de offerte zijn gratis en u zit nergens aan vast. U beslist zelf of en wanneer u de werken laat uitvoeren.' },
  { q: 'Kan ik foto\'s van mijn dak meesturen?', a: 'Ja, graag. Stuur foto\'s van het probleem of van uw dak via e-mail naar info@dsddakwerken.be of via sms naar 0478 67 25 82. Zo kunnen wij u vaak al telefonisch een eerste inschatting geven.' },
  { q: 'Wat doe ik bij een lek of stormschade?', a: 'Bel ons meteen op 0478 67 25 82. Zet intussen een emmer onder het lek en blijf zelf van het dak. Wij komen zo snel mogelijk langs om het dak voorlopig dicht te maken en plannen daarna de definitieve herstelling.' },
];
---
<Base title="Contact en gratis offerte | DSD Dakwerken Aalter" description="Contacteer DSD Dakwerken in Aalter voor een gratis offerte: bel 0478 67 25 82, mail of vul het formulier in. Wij bellen u binnen één werkdag terug." path="/contact/" schema={[breadcrumbSchema(crumbs), faqSchema(faq)]}>
  <Breadcrumbs items={crumbs} />

  <section class="section contact-hero">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Contact</span>
        <h1>Contacteer DSD Dakwerken voor een gratis offerte</h1>
        <p class="lead">Bel, sms, mail of vul het formulier in. Peter komt gratis en vrijblijvend langs in Aalter en heel het Meetjesland, en u krijgt een duidelijke offerte met vaste prijzen.</p>
      </div>
      <div class="split" style="align-items:start">
        <div>
          <ul class="contact-cards">
            <li class="card card--flat"><Icon name="phone" /><div><strong>Bel of sms</strong><a href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a><span class="muted small">Ook voor dringende herstellingen</span></div></li>
            <li class="card card--flat"><Icon name="mail" /><div><strong>E-mail</strong><a href={`mailto:${site.email}`}>{site.email}</a><span class="muted small">Stuur gerust foto's mee</span></div></li>
            <li class="card card--flat"><Icon name="map-pin" /><div><strong>Adres</strong><span>{site.address.street}<br />{site.address.postalCode} {site.address.city}</span><span class="muted small">Gevestigd in {site.address.subMunicipality}, bezoek enkel op afspraak</span></div></li>
            <li class="card card--flat"><Icon name="clock" /><div><strong>Bereikbaar</strong>{site.hours.map((h) => <span>{h.days}: {h.open} - {h.close}</span>)}</div></li>
          </ul>
          <div class="map" id="map" data-src={`https://www.google.com/maps?q=${mapQuery}&output=embed&hl=nl`}>
            <div class="map__placeholder">
              <Icon name="map-pin" size={32} />
              <p><strong>{site.address.street}, {site.address.postalCode} {site.address.city}</strong><br /><span class="small muted">De kaart wordt geladen via Google Maps. Google kan daarbij cookies plaatsen.</span></p>
              <button type="button" class="btn btn--outline" id="map-load">Kaart tonen</button>
              <a class="small" href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} target="_blank" rel="noopener">Open in Google Maps</a>
            </div>
          </div>
          <p class="small muted" style="margin-top:1rem">BTW {site.vat}. {site.legalName}, {site.address.street}, {site.address.postalCode} {site.address.city}.</p>
        </div>
        <ContactForm />
      </div>
    </div>
  </section>

  <Faq items={faq} heading="Veelgestelde vragen over uw aanvraag" />
</Base>

<script>
  const map = document.getElementById('map');
  document.getElementById('map-load')?.addEventListener('click', () => {
    if (!map) return;
    const iframe = document.createElement('iframe');
    iframe.title = 'Kaart met de ligging van DSD Dakwerken in Aalter';
    iframe.src = map.dataset.src ?? '';
    iframe.width = '100%';
    iframe.height = '320';
    iframe.style.border = '0';
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    map.replaceChildren(iframe);
  });
</script>

<style>
  .map__placeholder { display: grid; justify-items: center; gap: 0.75rem; text-align: center; padding: var(--space-6) var(--space-4); background: var(--c-cream); min-height: 320px; align-content: center; }
  .map__placeholder svg { color: var(--c-gold-deep); }
  .map__placeholder p { margin: 0; }
  .contact-cards { list-style: none; padding: 0; margin: 0 0 var(--space-5); display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .contact-cards li { display: flex; gap: 0.8rem; align-items: flex-start; margin: 0; }
  .contact-cards svg { color: var(--c-gold-deep); flex: none; margin-top: 0.2rem; }
  .contact-cards strong, .contact-cards a, .contact-cards span { display: block; }
  .contact-cards a { font-weight: 700; font-size: var(--fs-lg); text-decoration: none; }
  .map { border-radius: var(--radius); overflow: hidden; border: 1px solid var(--c-line); }
</style>
